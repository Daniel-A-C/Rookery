{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the on-demand tray popover window.",
  "windows": ["popover"],
  "permissions": [
    "core:default",
    "core:event:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "positioner:default"
  ]
}
